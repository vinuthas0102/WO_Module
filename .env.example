# ========================================
# DEMO/PROOF-OF-CONCEPT ENVIRONMENT
# ========================================
#
# ⚠️ WARNING: This is a demo system with simplified security
#
# - Custom authentication with plaintext passwords
# - Unrestricted anonymous database access
# - NOT production-ready without 4-6 weeks of security hardening
# - See SECURITY.md for complete disclosure
#
# FOR DEMO USE ONLY - Administrator-managed users only
# ========================================

# Supabase Configuration
# Get these values from your Supabase project dashboard at https://app.supabase.com
# IMPORTANT: Use a SEPARATE Supabase project for demo/testing - never use production database
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Application Configuration
# Set to false in production to disable debug logging
VITE_ENABLE_LOGGING=false

# ========================================
# Security Reminders for Demo Environment
# ========================================
#
# 1. Database Isolation:
#    - Use a dedicated Supabase project for demo
#    - Never mix demo and production data
#    - Regularly purge demo data
#
# 2. Access Control:
#    - Share demo URL only with trusted team members
#    - All user accounts are admin-managed (no self-registration)
#    - Credentials are documented in DEMO_CREDENTIALS.md
#
# 3. Known Limitations:
#    - Custom auth with plaintext passwords
#    - RLS policies allow unrestricted anon access
#    - Security scanners will show 104+ warnings (expected)
#    - No rate limiting or DDoS protection
#
# 4. Production Requirements:
#    - Migrate to Supabase Auth
#    - Implement proper RLS policies with auth.uid()
#    - Add password hashing and encryption
#    - Configure rate limiting and monitoring
#    - Estimated effort: 4-6 weeks
#
# For complete security disclosure, see SECURITY.md
# ========================================
