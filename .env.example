# Supabase Configuration
# Get these values from your Supabase project dashboard at https://app.supabase.com
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Application Configuration
# Set to false in production to disable debug logging
VITE_ENABLE_LOGGING=false

# Authentication Mode (optional)
# Set to 'mock' to use in-memory authentication without database connection
# Set to 'database' to use Supabase authentication (default if not specified)
# VITE_AUTH_MODE=mock

# Application Mode (optional)
# Set to 'demo' to use in-memory data without database connection
# Set to 'database' to use Supabase database (default if not specified)
# VITE_APP_MODE=demo
